# eMediCare Telemedicine Service Environment Variables
PORT=5008
MONGO_URI=mongodb://localhost:27017/emedicare_telemedicine

# Optional free meeting provider settings
# Default join links use Jitsi Meet and do not require an API key.
# JITSI_DOMAIN=meet.jit.si
# JITSI_PREFIX=eMediCare

# Optional WebRTC infrastructure if you later switch from hosted Jitsi
# TURN_SERVER_URL=turn:your-turn-server.com
# TURN_USERNAME=username
# TURN_PASSWORD=password
